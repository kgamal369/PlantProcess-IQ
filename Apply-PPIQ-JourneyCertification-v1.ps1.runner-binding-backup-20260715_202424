Write-Section "PPIQ journey certification implementation plan"
Write-Host ("Project root : {0}" -f $ProjectRoot)
Write-Host ("Files        : {0}" -f $payloads.Count)
foreach ($relative in $payloads.Keys) { Write-Host ("  - " + $relative) -ForegroundColor DarkGray }

if ($PlanOnly) {
    Write-Host ""
    Write-Host "Plan only: no files were changed." -ForegroundColor Yellow
    return
}

$stamp = Get-Date -Format "yyyyMMdd_HHmmss"
$backupRoot = Join-Path $ProjectRoot (".ppiq-backups\journey-certification\" + $stamp)
New-Item -ItemType Directory -Path $backupRoot -Force | Out-Null

Write-Section "Backing up files that will be replaced"
$backedUp = New-Object System.Collections.Generic.List[string]
$createdFiles = New-Object System.Collections.Generic.List[string]
$packageRelative = "Frontend/PlantProcess.Web/package.json"
$backupCandidates = @($payloads.Keys) + @($packageRelative)
foreach ($relative in $backupCandidates) {
    $destination = Join-Path $ProjectRoot ($relative.Replace('/', [System.IO.Path]::DirectorySeparatorChar))
    if (Test-Path -LiteralPath $destination) {
        $backup = Join-Path $backupRoot ($relative.Replace('/', [System.IO.Path]::DirectorySeparatorChar))
        $backupDirectory = Split-Path -Parent $backup
        New-Item -ItemType Directory -Path $backupDirectory -Force | Out-Null
        Copy-Item -LiteralPath $destination -Destination $backup -Force
        $backedUp.Add($relative)
        Write-Host ("BACKUP " + $relative) -ForegroundColor DarkGray
    }
    elseif ($relative -ne $packageRelative) {
        $createdFiles.Add($relative)
    }
}

try {
    Write-Section "Writing journey tests, UI implementation and quality gates"
    foreach ($relative in $payloads.Keys) {
        $destination = Join-Path $ProjectRoot ($relative.Replace('/', [System.IO.Path]::DirectorySeparatorChar))
        Write-Utf8NoBom -Path $destination -Content ([string]$payloads[$relative])
        Write-Host ("WRITE  " + $relative) -ForegroundColor Green
    }

    $node = (Get-Command node -ErrorAction Stop).Source
    $frontendRoot = Join-Path $ProjectRoot "Frontend\PlantProcess.Web"
    $packagePatch = Join-Path $frontendRoot "tools\journey-certification\patch-package.cjs"

    Write-Section "Patching package.json and checking generated JavaScript"
    Push-Location $frontendRoot
    try {
        & $node $packagePatch
        if ($LASTEXITCODE -ne 0) { throw "package.json patch failed with exit code $LASTEXITCODE" }

        foreach ($script in @(
            "tools\journey-certification\patch-package.cjs",
            "tools\journey-certification\audit-journey-ui.cjs",
            "tools\journey-certification\score-journey-certification.cjs"
        )) {
            & $node --check $script
            if ($LASTEXITCODE -ne 0) { throw "Node syntax validation failed: $script" }
        }
    }
    finally {
        Pop-Location
    }

    $manifest = [pscustomobject]@{
        appliedAtUtc = (Get-Date).ToUniversalTime().ToString("o")
        projectRoot = $ProjectRoot
        backupRoot = $backupRoot
        filesWritten = @($payloads.Keys)
        filesBackedUp = @($backedUp)
        validationRequested = (-not $SkipValidation)
    }
    $manifestPath = Join-Path $ProjectRoot "Documentation\JourneyCertification\last-apply-manifest.json"
    Write-Utf8NoBom -Path $manifestPath -Content ($manifest | ConvertTo-Json -Depth 8)
}
catch {
    Write-Host "Apply failed. Restoring replaced files from backup..." -ForegroundColor Red
    foreach ($relative in $backedUp) {
        $backup = Join-Path $backupRoot ($relative.Replace('/', [System.IO.Path]::DirectorySeparatorChar))
        $destination = Join-Path $ProjectRoot ($relative.Replace('/', [System.IO.Path]::DirectorySeparatorChar))
        if (Test-Path -LiteralPath $backup) {
            $destinationDirectory = Split-Path -Parent $destination
            New-Item -ItemType Directory -Path $destinationDirectory -Force | Out-Null
            Copy-Item -LiteralPath $backup -Destination $destination -Force
        }
    }
    foreach ($relative in $createdFiles) {
        $destination = Join-Path $ProjectRoot ($relative.Replace('/', [System.IO.Path]::DirectorySeparatorChar))
        if (Test-Path -LiteralPath $destination) {
            Remove-Item -LiteralPath $destination -Force -ErrorAction SilentlyContinue
        }
    }
    throw
}

Write-Section "Implementation applied"
Write-Host ("Backup: {0}" -f $backupRoot) -ForegroundColor Cyan
Write-Host "The pack deliberately fails certification when a journey seam or UI page is still below the gate; it does not manufacture green evidence." -ForegroundColor Yellow

if ($SkipValidation) {
    Write-Host "Validation skipped by switch. Run the certification runner later:" -ForegroundColor Yellow
    Write-Host ".\tools\journey-certification\Invoke-PPIQ-JourneyCertification.ps1" -ForegroundColor Gray
    return
}

Write-Section "Running automated journey certification"
$runner = Join-Path $ProjectRoot "tools\journey-certification\Invoke-PPIQ-JourneyCertification.ps1"
$runnerArgs = @(
    "-ProjectRoot", $ProjectRoot,
    "-ConnectionString", $ConnectionString,
    "-SmokeUserName", $SmokeUserName,
    "-SmokePassword", $SmokePassword
)
if ($SkipBackendIntegration) { $runnerArgs += "-SkipBackendIntegration" }
if ($SkipE2E) { $runnerArgs += "-SkipE2E" }
if ($InstallPlaywrightBrowser) { $runnerArgs += "-InstallPlaywrightBrowser" }

& $runner @runnerArgs
$validationExit = $LASTEXITCODE
if ($validationExit -ne 0) {
    Write-Host ""
    Write-Host "The implementation pack applied successfully, but the product is NOT YET CERTIFIED." -ForegroundColor Yellow
    Write-Host "Review Frontend\PlantProcess.Web\test-results\journey-certification\journey-score.md and the screenshots/logs." -ForegroundColor Yellow
    exit $validationExit
}

