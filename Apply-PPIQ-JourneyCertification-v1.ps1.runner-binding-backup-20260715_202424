function Invoke-LoggedCommand {
    param(
        [Parameter(Mandatory = $true)][string]$Id,
        [Parameter(Mandatory = $true)][string]$WorkingDirectory,
        [Parameter(Mandatory = $true)][string]$FilePath,
        [Parameter(Mandatory = $true)][string[]]$Arguments,
        [hashtable]$Environment = @{},
        [bool]$Required = $true
    )

    $logPath = Join-Path $LogRoot ($Id + ".log")
    $started = Get-Date
    $oldEnvironment = @{}

    foreach ($key in $Environment.Keys) {
        $oldEnvironment[$key] = [Environment]::GetEnvironmentVariable($key, "Process")
        [Environment]::SetEnvironmentVariable($key, [string]$Environment[$key], "Process")
    }

    Write-Host ""
    Write-Host ("=" * 96) -ForegroundColor DarkGray
    Write-Host ("[{0}] {1} {2}" -f $Id, $FilePath, ($Arguments -join " ")) -ForegroundColor Cyan
    Write-Host ("Working directory: {0}" -f $WorkingDirectory) -ForegroundColor DarkGray
    Write-Host ("=" * 96) -ForegroundColor DarkGray

    $exitCode = 1
    $errorText = $null
    Push-Location $WorkingDirectory
    try {
        & $FilePath @Arguments *>&1 | Tee-Object -FilePath $logPath
        $exitCode = $LASTEXITCODE
        if ($null -eq $exitCode) { $exitCode = 0 }
    }
    catch {
        $errorText = $_.Exception.ToString()
        $errorText | Add-Content -LiteralPath $logPath
        $exitCode = 1
    }
    finally {
        Pop-Location
        foreach ($key in $Environment.Keys) {
            [Environment]::SetEnvironmentVariable($key, $oldEnvironment[$key], "Process")
        }
    }

    $finished = Get-Date
    $status = if ($exitCode -eq 0) { "PASS" } else { "FAIL" }
    $result = [pscustomobject]@{
        id = $Id
        status = $status
        exitCode = [int]$exitCode
        required = $Required
        startedAt = $started.ToUniversalTime().ToString("o")
        finishedAt = $finished.ToUniversalTime().ToString("o")
        durationSeconds = [Math]::Round(($finished - $started).TotalSeconds, 2)
        log = $logPath
        error = $errorText
    }
    $script:CommandResults.Add($result)

    if ($status -eq "PASS") {
        Write-Host "[$Id] PASS" -ForegroundColor Green
    }
    else {
        Write-Host "[$Id] FAIL - see $logPath" -ForegroundColor Red
    }

    return $exitCode
}

