[CmdletBinding()]
param(
    [string]$ProjectRoot = "C:\Workspace\PlantProcess-IQ",
    [switch]$PlanOnly,
    [switch]$Force,
    [switch]$SkipValidation,
    [switch]$SkipBackendIntegration,
    [switch]$SkipE2E,
    [switch]$InstallPlaywrightBrowser,
    [string]$ConnectionString = "Host=127.0.0.1;Port=5432;Database=ppiq_app;Username=ppiq_dev;Password=ppiq_dev_local_only",
    [string]$SmokeUserName = "e2eadmin",
    [string]$SmokePassword = "E2eAdmin_Local123!"
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

function Write-Section {
    param([string]$Title)
    Write-Host ""
    Write-Host ("=" * 104) -ForegroundColor DarkGray
    Write-Host $Title -ForegroundColor Cyan
    Write-Host ("=" * 104) -ForegroundColor DarkGray
}

function Resolve-RequiredPath {
    param([string]$Path, [string]$Label)
    if (-not (Test-Path -LiteralPath $Path)) { throw "$Label not found: $Path" }
    return (Resolve-Path -LiteralPath $Path).Path
}

function Write-Utf8NoBom {
    param([string]$Path, [string]$Content)
    $directory = Split-Path -Parent $Path
    if (-not (Test-Path -LiteralPath $directory)) {
        New-Item -ItemType Directory -Path $directory -Force | Out-Null
    }
    $utf8 = New-Object System.Text.UTF8Encoding($false)
    [System.IO.File]::WriteAllText($Path, ($Content -replace "`r?`n", "`r`n"), $utf8)
}

function Assert-Anchor {
    param([string]$RelativePath, [string]$Anchor)
    $full = Join-Path $ProjectRoot ($RelativePath.Replace('/', [System.IO.Path]::DirectorySeparatorChar))
    if (-not (Test-Path -LiteralPath $full)) { throw "Required source file missing: $RelativePath" }
    $text = [System.IO.File]::ReadAllText($full)
    if (-not $text.Contains($Anchor) -and -not $Force) {
        throw "Source drift detected in $RelativePath. Expected anchor not found: $Anchor. Re-run with -Force only after reviewing the current file."
    }
}

$ProjectRoot = Resolve-RequiredPath -Path $ProjectRoot -Label "PlantProcess IQ project root"
$required = @(
    "Backend\PlantProcessIQ.sln",
    "Frontend\PlantProcess.Web\package.json",
    "Frontend\PlantProcess.Web\src\main.tsx",
    "Frontend\PlantProcess.Web\src\App.tsx",
    "Frontend\PlantProcess.Web\playwright.config.ts"
)
foreach ($relative in $required) {
    if (-not (Test-Path -LiteralPath (Join-Path $ProjectRoot $relative))) {
        throw "This does not look like the expected PlantProcess IQ repository. Missing: $relative"
    }
}

