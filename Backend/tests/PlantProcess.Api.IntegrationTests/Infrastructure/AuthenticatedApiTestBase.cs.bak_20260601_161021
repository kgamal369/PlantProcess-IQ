using System.Net.Http.Headers;
using System.Net.Http.Json;
using System.Text.Json;
using FluentAssertions;
using Microsoft.AspNetCore.Mvc.Testing;

namespace PlantProcess.Api.IntegrationTests.Infrastructure;

public abstract class AuthenticatedApiTestBase : IClassFixture<WebApplicationFactory<Program>>
{
    protected const string TestAdminUserName = "admin";
    protected const string TestAdminPassword = "PpiqIntegrationAdmin!2026_Rotated";

    private const string LocalLaptopConnectionString =
        "Host=127.0.0.1;Port=5432;Database=plantprocessiq;Username=plantprocess;Password=plantprocess123";

    protected readonly WebApplicationFactory<Program> Factory;

    private static readonly object EnvironmentLock = new();
    private static bool _environmentConfigured;

    protected AuthenticatedApiTestBase(WebApplicationFactory<Program> factory)
    {
        ConfigureTestEnvironmentOnce();
        Factory = factory;
    }

    protected HttpClient CreateAnonymousClient()
    {
        return Factory.CreateClient(new WebApplicationFactoryClientOptions
        {
            AllowAutoRedirect = false
        });
    }

    protected async Task<HttpClient> CreateAuthenticatedClientAsync()
    {
        var client = CreateAnonymousClient();

        var loginResponse = await client.PostAsJsonAsync("/auth/login", new
        {
            UserName = TestAdminUserName,
            Password = TestAdminPassword
        });

        if (!loginResponse.IsSuccessStatusCode)
        {
            var body = await loginResponse.Content.ReadAsStringAsync();

            throw new InvalidOperationException(
                "Integration test login failed. " +
                $"Status={(int)loginResponse.StatusCode} {loginResponse.StatusCode}. " +
                $"Body={body}");
        }

        var json = await loginResponse.Content.ReadFromJsonAsync<JsonElement>();

        string? token = null;

        if (json.TryGetProperty("accessToken", out var accessTokenProperty))
        {
            token = accessTokenProperty.GetString();
        }
        else if (json.TryGetProperty("token", out var tokenProperty))
        {
            token = tokenProperty.GetString();
        }

        token.Should().NotBeNullOrWhiteSpace("login must return a bearer token");

        client.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        return client;
    }

    private static void ConfigureTestEnvironmentOnce()
    {
        lock (EnvironmentLock)
        {
            if (_environmentConfigured)
            {
                return;
            }

            /*
             * Critical local-test rule:
             * Do NOT read Infrastructure/deploy/.env here.
             * That file is Docker/server-oriented and may point to plantprocess_app_db/postgres.
             * Karim's local laptop PostgreSQL is direct Windows localhost:
             *   DB       = plantprocessiq
             *   User     = plantprocess
             *   Password = plantprocess123
             */
            Force("ASPNETCORE_ENVIRONMENT", "Development");
            Force("DOTNET_ENVIRONMENT", "Development");

            Force("PPIQ_TEST_CONNECTION_STRING", LocalLaptopConnectionString);
            Force("PLANTPROCESS_TEST_CONNECTION_STRING", LocalLaptopConnectionString);
            Force("ConnectionStrings__PlantProcessDb", LocalLaptopConnectionString);

            Force("PLANTPROCESS_ALLOWED_ORIGINS", "http://localhost:5173,http://localhost:3000");

            Force("PlantProcess__RequireDatabaseConnectionString", "true");
            Force("PlantProcess__PlantTimeZoneId", "Europe/Berlin");
            Force("PlantProcess__PlantUtcOffsetMinutes", "60");

            Force("PlantProcess__Auth__SigningKey", "SuperSecretTestKeyThatIsAtLeast32Bytes!!");
            Force("PlantProcess__Auth__Issuer", "PlantProcessIQ");
            Force("PlantProcess__Auth__Audience", "PlantProcessIQ.Client");
            Force("PlantProcess__Auth__AccessTokenMinutes", "60");

            Force("PlantProcess__Auth__BootstrapAdminUser", "__bootstrap_disabled_for_integration_tests__");
            Force("PlantProcess__Auth__BootstrapAdminPassword", "BootstrapDisabledOnlyForTests123!");

            Force("PlantProcess__Auth__Users__0__UserName", TestAdminUserName);
            Force("PlantProcess__Auth__Users__0__Password", TestAdminPassword);
            Force("PlantProcess__Auth__Users__0__Role", "Admin");
            Force("PlantProcess__Auth__Users__0__DisplayName", "Integration Test Admin");
            Force("PlantProcess__Auth__Users__0__IsBootstrapAdmin", "false");
            Force("PlantProcess__Auth__Users__0__ForcePasswordChangeOnFirstLogin", "false");

            _environmentConfigured = true;
        }
    }

    private static void Force(string key, string value)
    {
        Environment.SetEnvironmentVariable(key, value, EnvironmentVariableTarget.Process);
    }
}
