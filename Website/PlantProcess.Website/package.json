{
    "name":  "sou-plantprocess-website",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "check:tagline":  "node scripts/check-tagline.mjs",
                    "test:phase7":  "playwright test --config playwright.phase7.config.ts",
                    "dev":  "vite",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "check:ts":  "tsc -b --verbose",
                    "lint":  "node scripts/validate-website-content.mjs",
                    "test":  "node scripts/validate-website-content.mjs",
                    "validate:brand":  "node scripts/validate-website-content.mjs",
                    "phase10:guard":  "node ../../tools/phase9-phase10/website-phase10-guard.cjs",
                    "validate:commercial:v2":  "node scripts/validate-commercial-v2.mjs",
                    "test:commercial:e2e":  "playwright test --config playwright.commercial.config.ts",
                    "certify:commercial:v2":  "npm run build \u0026\u0026 npm run validate:commercial:v2 \u0026\u0026 npm run test:commercial:e2e",
                    "validate:content":  "node scripts/validate-commercial-v2.mjs",
                    "e2e":  "playwright test --config playwright.commercial.config.ts",
                    "test:phase10":  "playwright test --config playwright.commercial.config.ts",
                    "validate:phase10":  "npm run certify:commercial:v2",
                    "validate":  "npm run certify:commercial:v2",
                    "validate:phase7":  "node scripts/validate-phase7-content.mjs",
                    "verify:website":  "playwright test --config playwright.verify.config.ts"
                },
    "dependencies":  {
                         "lucide-react":  "^1.14.0",
                         "react":  "^19.2.6",
                         "react-dom":  "^19.2.6",
                         "react-router-dom":  "^7.15.0"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.60.0",
                            "@types/node":  "^24.12.3",
                            "@types/react":  "^19.2.14",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^6.0.1",
                            "typescript":  "~6.0.2",
                            "vite":  "^8.0.12"
                        }
}
