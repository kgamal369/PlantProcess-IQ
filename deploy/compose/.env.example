# =====================================================================================
# PlantProcess IQ - canonical compose secrets/config (deploy/compose/.env)
# Copy to deploy/compose/.env on the server (gitignored, server-only) and fill real values.
# Keys use the app's NATIVE names: ASP.NET maps "__" -> ":" (so PlantProcess__Auth__SigningKey
# -> PlantProcess:Auth:SigningKey, which StartupConfigurationValidator reads).
# =====================================================================================

# ---- Postgres (consumed by ppiq-postgres and interpolated into the connection string) ----
POSTGRES_USER=plantprocess_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=plantprocess_app_db
POSTGRES_PORT=5432
PPIQ_DB_HOST=ppiq-postgres

# ---- Runtime environment ----
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production

# ---- App connection string (compose environment: overrides this; kept here for clarity) ----
ConnectionStrings__PlantProcessDb=Host=ppiq-postgres;Port=5432;Database=plantprocess_app_db;Username=plantprocess_admin;Password=CHANGE_ME_strong_db_password

# ---- Auth: ALL required outside Development ----
# SigningKey: >= 64 chars, non-development (no DEV_ONLY / CHANGE_THIS prefixes).
# Generate one with:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 72 | % {[char]$_})
PlantProcess__Auth__SigningKey=CHANGE_ME_set_a_64_plus_char_random_signing_key_not_starting_with_dev
PlantProcess__Auth__Issuer=plantprocess-iq
PlantProcess__Auth__Audience=plantprocess-iq-clients
PlantProcess__Auth__RequireAdminMfa=false

# Bootstrap admin MUST be the disabled sentinel in Production:
PlantProcess__Auth__BootstrapAdminUser=bootstrap-disabled
PlantProcess__Auth__BootstrapAdminPassword=__DISABLED__

# At least one REAL admin (Role=Admin, IsBootstrapAdmin=false). Index 0:
PlantProcess__Auth__Users__0__UserName=admin
PlantProcess__Auth__Users__0__Password=CHANGE_ME_strong_admin_password
PlantProcess__Auth__Users__0__Role=Admin
PlantProcess__Auth__Users__0__IsBootstrapAdmin=false

# ---- CORS: real frontend origin(s); NO localhost / wildcard in Production ----
PLANTPROCESS_ALLOWED_ORIGINS=https://plantprocessiq.example.com

# ---- Frontend build args (image build time) ----
VITE_API_BASE_URL=/api
VITE_WEBSITE_API_BASE_URL=/api
