# =====================================================================================
# PPIQ canonical stack environment - COPY to .env on the server, fill REAL values.
# The committed file is the template; .env itself is NEVER committed.
# Startup guard (P01/P02) hard-fails if SigningKey < 64 chars or the conn key is wrong.
# =====================================================================================

# --- database (server: ppiq-postgres container on ppiq-network) ---
POSTGRES_USER=plantprocess_admin
POSTGRES_PASSWORD=CHANGE_ME_REAL_PASSWORD
POSTGRES_DB=plantprocess_app_db
PPIQ_DB_HOST=ppiq-postgres
# local laptop topology instead:  PPIQ_DB_HOST=host.docker.internal

PPIQ_CONNECTION_STRING=Host=${PPIQ_DB_HOST};Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# --- auth (REQUIRED outside Development) ---
# >= 64 characters. Generate:  openssl rand -base64 64 | tr -d '\n'
PPIQ_SIGNING_KEY=CHANGE_ME_64_PLUS_CHARACTERS_________________________________________
PPIQ_ADMIN_USER=ppiq-admin
PPIQ_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PPIQ_ADMIN_ROLE=Admin

# --- web ---
PPIQ_ALLOWED_ORIGINS=https://YOUR-DOMAIN
ASPNETCORE_ENVIRONMENT=Production

# --- T21 / T22 (Phase 1) ---
# Admin-MFA enforcement stays OFF until the step-up loop is demo-verified:
PlantProcess__Auth__RequireAdminMfa=false
# Test-mode (NEVER true in Production without explicit accept-risk - see docs/TESTMODE.md):
PPIQ_TESTMODE__SeedUsers=false
PPIQ_TESTMODE__ForceTier=