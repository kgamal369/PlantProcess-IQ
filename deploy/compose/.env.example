# PlantProcess IQ - server-only environment for the demo compose stack.
# Copy this to deploy/compose/.env ON THE SERVER (it is gitignored and never
# committed). docker compose auto-loads ./.env and interpolates these values
# into docker-compose.demo.yml at build/up time.

# --- PostgreSQL (MUST match the already-running ppiq-postgres container) -----
POSTGRES_USER=plantprocess_admin
POSTGRES_PASSWORD=set-this-to-match-the-running-postgres-password
POSTGRES_DB=plantprocess_app_db
# Host loopback port (the container is always bound to 127.0.0.1 only):
POSTGRES_PORT=5432

# --- Frontend build args -----------------------------------------------------
VITE_API_BASE_URL=/api
VITE_WEBSITE_API_BASE_URL=/api

# --- API listen port override (optional) -------------------------------------
# The API image listens on :5063 by default. If your Caddy proxies to
# plantprocess-api:8080, uncomment the line below in docker-compose.demo.yml
# (the API service) so the two agree.
# ASPNETCORE_URLS=http://0.0.0.0:8080