# =====================================================================================
# PlantProcess IQ â€” LOCAL DEVELOPMENT ENVIRONMENT  (deploy/compose/.env.dev)  â€” M1-T02
# -------------------------------------------------------------------------------------
# COMMITTED ON PURPOSE. These are LOCAL-ONLY, NON-SECRET credentials that only ever
# point at LOCAL containers, so the dev/test environment is reproducible and never
# "vanishes". They are NEVER used in production. Real production secrets live ONLY in
# deploy/compose/.env on the server (gitignored) and /var/lib/ppiq-preserve/.env.
#
# deploy/scripts/ppiq.ps1 (M1-T07) exports these into the process before running
# dotnet / npm / docker compose. ASP.NET maps "__" -> ":".
# =====================================================================================

# ---- Runtime (Development: the startup guard does NOT require strict secrets) ----
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# ---- App Postgres (containerised locally; published to 127.0.0.1 by docker-compose.local.yml) ----
POSTGRES_USER=ppiq_dev
POSTGRES_PASSWORD=ppiq_dev_local_only
POSTGRES_DB=ppiq_app
POSTGRES_PORT=5432

# ---- App connection string (native `dotnet run` / tests reach the published container) ----
ConnectionStrings__PlantProcessDb=Host=localhost;Port=5432;Database=ppiq_app;Username=ppiq_dev;Password=ppiq_dev_local_only
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ppiq_app;Username=ppiq_dev;Password=ppiq_dev_local_only

# ---- Integration-test config (the clean-machine fix: host flag + DB + key, no shell vars) ----
PPIQ_TEST_CONNECTION_STRING=Host=localhost;Port=5432;Database=ppiq_app;Username=ppiq_dev;Password=ppiq_dev_local_only
PPIQ_TEST_PG_CONNSTRING=Host=localhost;Port=5432;Database=ppiq_app;Username=ppiq_dev;Password=ppiq_dev_local_only
PPIQ_FORCE_EXTERNAL_API_TEST_HOST=1

# ---- Auth (>=64 chars; the DEV_ONLY_ prefix is accepted in Development and REJECTED in Production) ----
PlantProcess__Auth__SigningKey=ppiq-local-signing-key-not-for-production-0a1b2c3d4e5f60718293a4b5c6
PlantProcess__Auth__Issuer=plantprocess-iq
PlantProcess__Auth__Audience=plantprocess-iq-clients
PlantProcess__Auth__RequireAdminMfa=false
PlantProcess__Auth__BootstrapAdminUser=bootstrap-disabled
PlantProcess__Auth__BootstrapAdminPassword=__DISABLED__

# ---- Seeded role users (app hashes with Argon2id on load; one per role for dev/e2e) ----
PlantProcess__Auth__Users__0__UserName=admin
PlantProcess__Auth__Users__0__Password=DevAdmin123!
PlantProcess__Auth__Users__0__Role=Admin
PlantProcess__Auth__Users__0__IsBootstrapAdmin=false
PlantProcess__Auth__Users__1__UserName=exec
PlantProcess__Auth__Users__1__Password=DevExec123!
PlantProcess__Auth__Users__1__Role=Executive
PlantProcess__Auth__Users__1__IsBootstrapAdmin=false
PlantProcess__Auth__Users__2__UserName=engineer
PlantProcess__Auth__Users__2__Password=DevEng123!
PlantProcess__Auth__Users__2__Role=Engineer
PlantProcess__Auth__Users__2__IsBootstrapAdmin=false
PlantProcess__Auth__Users__3__UserName=operator
PlantProcess__Auth__Users__3__Password=DevOp123!
PlantProcess__Auth__Users__3__Role=Operator
PlantProcess__Auth__Users__3__IsBootstrapAdmin=false
PlantProcess__Auth__Users__4__UserName=viewer
PlantProcess__Auth__Users__4__Password=DevView123!
PlantProcess__Auth__Users__4__Role=Viewer
PlantProcess__Auth__Users__4__IsBootstrapAdmin=false

# ---- CORS (local frontend dev servers) ----
PLANTPROCESS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Frontend ----
VITE_API_BASE_URL=/api
VITE_WEBSITE_API_BASE_URL=/api
