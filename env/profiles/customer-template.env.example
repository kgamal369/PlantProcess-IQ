# ============================================================
# PlantProcess IQ — Customer Profile Template
#
# Use this for every customer deployment.
# Copy to:
#   env/profiles/customer-<name>.env
#
# Supported modes:
#   PPIQ_MAIN_DB_MODE=native | docker | external | managed
#   PPIQ_DEMO_SOURCES_MODE=docker | external | disabled | mixed
# ============================================================

PPIQ_PROFILE=customer
PPIQ_CUSTOMER_CODE=CHANGE_ME_CUSTOMER
PPIQ_RUNTIME_TOPOLOGY=customer-template

PPIQ_MAIN_DB_MODE=CHANGE_ME_native_docker_external_managed
PPIQ_DEMO_SOURCES_MODE=CHANGE_ME_docker_external_disabled_mixed
PPIQ_START_MAIN_DB=false
PPIQ_START_DEMO_SOURCES=false

PPIQ_API_HOST=0.0.0.0
PPIQ_API_PORT=CHANGE_ME_API_PORT
PPIQ_WEB_HOST=0.0.0.0
PPIQ_WEB_PORT=CHANGE_ME_WEB_PORT
PPIQ_WEBSITE_HOST=0.0.0.0
PPIQ_WEBSITE_PORT=CHANGE_ME_WEBSITE_PORT

POSTGRES_HOST=CHANGE_ME_DB_HOST
POSTGRES_PORT=CHANGE_ME_DB_PORT
POSTGRES_HOST_PORT=CHANGE_ME_DB_HOST_PORT
POSTGRES_DB=CHANGE_ME_DB_NAME
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_Password_REMOVED_FROM_TRACKED_TEMPLATE=SET_IN_IGNORED_ENV_FILE

ConnectionStrings__PlantProcessDb=


ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:CHANGE_ME_API_PORT
PLANTPROCESS_ALLOWED_ORIGINS=https://CHANGE_ME_APP_DOMAIN,https://CHANGE_ME_WEBSITE_DOMAIN

VITE_API_BASE_URL=https://CHANGE_ME_API_DOMAIN
VITE_WEBSITE_API_BASE_URL=https://CHANGE_ME_API_DOMAIN

PPIQ_SMOKE_USERNAME=CHANGE_ME_SMOKE_USER
PPIQ_SMOKE_Password_REMOVED_FROM_TRACKED_TEMPLATE=SET_IN_IGNORED_ENV_FILE
VITE_SMOKE_USERNAME=CHANGE_ME_SMOKE_USER
VITE_SMOKE_Password_REMOVED_FROM_TRACKED_TEMPLATE=SET_IN_IGNORED_ENV_FILE


PlantProcess__Auth__SigningKey=PLACEHOLDER_REPLACE_WITH_32_PLUS_CHAR_VALUE_IN_IGNORED_ENV
POSTGRES_APP_DB=plantprocessiq
POSTGRES_PASSWORD=SET_IN_IGNORED_ENV_FILE
PPIQ_BOOTSTRAP_ADMIN_PASSWORD=SET_IN_IGNORED_ENV_FILE
PPIQ_BOOTSTRAP_ADMIN_USER=customer-owner
PPIQ_SMOKE_PASSWORD=SET_IN_IGNORED_ENV_FILE
