# ============================================================
# PlantProcess IQ — Server Docker Profile Example
# All runtime services are Docker containers.
# Copy to server.env and replace CHANGE_ME values.
# ============================================================

PPIQ_PROFILE=server
PPIQ_RUNTIME_TOPOLOGY=server-docker
PPIQ_MAIN_DB_MODE=docker
PPIQ_DEMO_SOURCES_MODE=docker
PPIQ_START_MAIN_DB=true
PPIQ_START_DEMO_SOURCES=true

PPIQ_API_HOST=0.0.0.0
PPIQ_API_PORT=5063
PPIQ_WEB_HOST=0.0.0.0
PPIQ_WEB_PORT=5173
PPIQ_WEBSITE_HOST=0.0.0.0
PPIQ_WEBSITE_PORT=5080

POSTGRES_HOST=plantprocess-db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=plantprocessiq
POSTGRES_USER=plantprocess
POSTGRES_PASSWORD=CHANGE_ME_SERVER_DB_PASSWORD

ConnectionStrings__PlantProcessDb=Host=plantprocess-db;Port=5432;Database=plantprocessiq;Username=plantprocess;Password=CHANGE_ME_SERVER_DB_PASSWORD
ConnectionStrings__DefaultConnection=Host=plantprocess-db;Port=5432;Database=plantprocessiq;Username=plantprocess;Password=CHANGE_ME_SERVER_DB_PASSWORD

ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5063
PLANTPROCESS_ALLOWED_ORIGINS=https://app.plantprocessiq.com,https://plantprocessiq.com

VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_API_BASE_URL=https://api.plantprocessiq.com
VITE_WEBSITE_API_BASE_URL=https://api.plantprocessiq.com

PPIQ_SMOKE_USERNAME=CHANGE_ME_SERVER_SMOKE_USER
PPIQ_SMOKE_PASSWORD=CHANGE_ME_SERVER_SMOKE_PASSWORD
VITE_SMOKE_USERNAME=CHANGE_ME_SERVER_SMOKE_USER
VITE_SMOKE_PASSWORD=CHANGE_ME_SERVER_SMOKE_PASSWORD
