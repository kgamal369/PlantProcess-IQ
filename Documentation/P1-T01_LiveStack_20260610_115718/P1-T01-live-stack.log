  LayoutJson: "{\\"x\\":0,\\"y\\":0,\\"w\\":8,\\"h\\":5}",
  DisplayOptionsJson: "{\\"maxRows\\":50,\\"rawRowLimit\\":10000,\\"sortDirection\\":\\"desc\\",\\"includeWarnings\\":true}",
  SortOrder: 1,
  IsActive: true,
  SourceSystem: "p3-t15-contract-test",
