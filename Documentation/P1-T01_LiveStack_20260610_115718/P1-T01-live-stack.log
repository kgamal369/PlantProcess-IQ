PS>function Backup-And-Write {
    param(
        [Parameter(Mandatory=$true)][string]$Path,
        [Parameter(Mandatory=$true)][string]$Content
    )

    Backup-File $Path
    Write-TextFile -Path $Path -Content $Content
}
