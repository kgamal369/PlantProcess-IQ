PS>function Remove-CrashLoopOrphanContainers {
    param([string[]]$KeepContainerIds)

    $all = & docker ps -a --format "{{.ID}}|{{.Names}}|{{.Status}}"
    $removed = @()

    foreach ($line in $all) {
        if ([string]::IsNullOrWhiteSpace($line)) {
            continue
        }

        $parts = $line -split "\|", 3
        if ($parts.Count -lt 3) {
            continue
        }

        $id = $parts[0]
        $name = $parts[1]
        $status = $parts[2]

        $isPlantProcess = $name -match "^(plantprocess|ppiq)"
        $isDb = $name -match "(postgres|mysql|oracle|mssql|redis|db)"
        $isKeep = $KeepContainerIds -contains $id
        $isBad = $status -match "Exited|Restarting|Dead|Created"

        if ($isPlantProcess -and -not $isDb -and -not $isKeep -and $isBad) {
            Write-Yellow "Removing crash-loop/orphan container: $name [$status]"
            docker rm -f $id | Out-Null
            $removed += "$name [$status]"
        }
    }

    return $removed
}
