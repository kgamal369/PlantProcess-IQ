PS>try {
    Write-P1 "Starting P1-T01 live-stack stabilization."

    Invoke-Checked -Name "docker version" -FilePath "docker" -Arguments @("version")
    Invoke-Checked -Name "git status" -FilePath "git" -Arguments @("status", "--short")

    $Commit = Get-GitValue @("rev-parse", "--short", "HEAD")
    $Branch = Get-GitValue @("rev-parse", "--abbrev-ref", "HEAD")
    $BuildUtc = (Get-Date).ToUniversalTime().ToString("o")
    $ComposeFile = Find-ComposeFile
    $ComposeServices = Get-ComposeServices -ComposeFile $ComposeFile
    $AppServices = Select-AppServices -Services $ComposeServices

    Write-P1 "Commit       : $Commit"
    Write-P1 "Branch       : $Branch"
    Write-P1 "Compose file : $ComposeFile"
    Write-P1 "App services : $($AppServices -join ', ')"

    $buildInfo = @"
{
  "product": "PlantProcess IQ",
  "phase": "P1-T01 Live-stack stabilization",
  "commit": "$Commit",
  "branch": "$Branch",
  "builtAtUtc": "$BuildUtc",
  "composeProject": "$ComposeProject",
  "composeFile": "$ComposeFile"
}
"@

    Write-TextFile -Path (Join-Path $RepoRoot "deploy\build-info.json") -Content $buildInfo

    if (Test-Path (Join-Path $RepoRoot "Frontend\PlantProcess.Web\public")) {
        Write-TextFile -Path (Join-Path $RepoRoot "Frontend\PlantProcess.Web\public\build-info.json") -Content $buildInfo
    }

    if (Test-Path (Join-Path $RepoRoot "Website\PlantProcess.Website\public")) {
        Write-TextFile -Path (Join-Path $RepoRoot "Website\PlantProcess.Website\public\build-info.json") -Content $buildInfo
    }

    $programPath = Join-Path $RepoRoot "Backend\PlantProcess.Api\Program.cs"
    if (Test-Path $programPath) {
        $program = Get-Content -Raw -Path $programPath

        if ($program -notmatch "PPIQ_P1_T01_VERSION_ENDPOINT") {
            Backup-File $programPath

            $marker = "var app = builder.Build();"

            if ($program.Contains($marker)) {
                $insert = @'
var app = builder.Build();

// PPIQ_P1_T01_VERSION_ENDPOINT
app.MapGet("/version", () => Results.Ok(new
{
    product = "PlantProcess IQ",
    phase = "P1-T01 Live-stack stabilization",
    commit = Environment.GetEnvironmentVariable("PPIQ_BUILD_COMMIT") ?? "unknown",
    branch = Environment.GetEnvironmentVariable("PPIQ_BUILD_BRANCH") ?? "unknown",
    builtAtUtc = Environment.GetEnvironmentVariable("PPIQ_BUILD_UTC") ?? "unknown",
    source = "api-runtime"
}))
.AllowAnonymous()
.WithName("PpiqVersion");

app.MapGet("/api/version", () => Results.Ok(new
{
    product = "PlantProcess IQ",
    phase = "P1-T01 Live-stack stabilization",
    commit = Environment.GetEnvironmentVariable("PPIQ_BUILD_COMMIT") ?? "unknown",
    branch = Environment.GetEnvironmentVariable("PPIQ_BUILD_BRANCH") ?? "unknown",
    builtAtUtc = Environment.GetEnvironmentVariable("PPIQ_BUILD_UTC") ?? "unknown",
    source = "api-runtime"
}))
.AllowAnonymous()
.WithName("PpiqApiVersion");

'@
                $program = $program.Replace($marker, $insert)
                Write-TextFile -Path $programPath -Content $program
                Write-P1 "Injected /version endpoint into Program.cs."
            }
            else {
                Write-Yellow "Could not find Program.cs marker 'var app = builder.Build();'. /version endpoint was not injected."
            }
        }
        else {
            Write-P1 "/version endpoint marker already exists."
        }
    }

    $envFile = Join-Path $LiveDir "docker-compose.p1-t01.env.yml"
    $envCompose = @"
services:
"@

    foreach ($svc in $AppServices) {
        $envCompose += @"

  $svc:
    environment:
      PPIQ_BUILD_COMMIT: "$Commit"
      PPIQ_BUILD_BRANCH: "$Branch"
      PPIQ_BUILD_UTC: "$BuildUtc"
"@
    }

    Write-TextFile -Path $envFile -Content $envCompose

    $volumeBefore = Get-PostgresVolumeIdentity
    $rowsBefore = Get-PostgresRowCountsSnapshot

    Write-TextFile -Path (Join-Path $EvidenceRoot "postgres-volume-before.txt") -Content $volumeBefore
    Write-TextFile -Path (Join-Path $EvidenceRoot "postgres-rowcounts-before.txt") -Content $rowsBefore

    $runningIdsBefore = Get-ContainerIdsForServices -ComposeFile $ComposeFile -Services $AppServices
    $removedOrphans = Remove-CrashLoopOrphanContainers -KeepContainerIds $runningIdsBefore
    Write-TextFile -Path (Join-Path $EvidenceRoot "removed-orphans.txt") -Content (($removedOrphans -join "`n") + "`n")

    $knownGoodTag = "known-good-$Today-$Commit"

    Write-P1 "Tagging current app images as known-good tag: $knownGoodTag"

    $rollbackItems = @()
    foreach ($id in $runningIdsBefore) {
        $image = (& docker inspect -f "{{.Config.Image}}" $id).Trim()
        $name = (& docker inspect -f "{{.Name}}" $id).Trim().TrimStart("/")

        if (-not [string]::IsNullOrWhiteSpace($image)) {
            $base = ($image -split ":", 2)[0]
            $tagged = "$base`:$knownGoodTag"

            docker image inspect $image *> $null
            if ($LASTEXITCODE -eq 0) {
                docker tag $image $tagged
                if ($LASTEXITCODE -ne 0) {
                    throw "Failed to tag image $image as $tagged"
                }

                $rollbackItems += [pscustomobject]@{
                    container = $name
                    currentImage = $image
                    knownGoodImage = $tagged
                }
            }
        }
    }

    $rollbackManifest = Join-Path $LiveDir "rollback-p1-t01-$Stamp.json"
    $rollbackItems | ConvertTo-Json -Depth 5 | Set-Content -Path $rollbackManifest -Encoding utf8

    $rollbackScript = Join-Path $LiveDir "rollback-p1-t01.ps1"
    Backup-And-Write -Path $rollbackScript -Content @'
param(
    [string]$RepoRoot = "C:\Workspace\PlantProcess-IQ",
    [string]$ComposeProject = "plantprocessiq",
    [string]$ComposeFile = "",
    [string]$Manifest = "",
    [string[]]$Services = @()
)

$ErrorActionPreference = "Stop"

Set-Location $RepoRoot

if ([string]::IsNullOrWhiteSpace($ComposeFile)) {
    $candidates = @(
        "deploy\compose\docker-compose.demo.yml",
        "deploy\compose\docker-compose.prod.yml",
        "deploy\compose\docker-compose.base.yml",
        "Infrastructure\deploy\docker-compose.demo.yml"
    )

    foreach ($candidate in $candidates) {
        $full = Join-Path $RepoRoot $candidate
        if (Test-Path $full) {
            $ComposeFile = $full
            break
        }
    }
}

if ([string]::IsNullOrWhiteSpace($ComposeFile) -or -not (Test-Path $ComposeFile)) {
    throw "Compose file not found."
}

if ([string]::IsNullOrWhiteSpace($Manifest)) {
    $Manifest = Get-ChildItem -Path (Join-Path $RepoRoot "deploy\live") -Filter "rollback-p1-t01-*.json" |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1 |
        ForEach-Object { $_.FullName }
}

if ([string]::IsNullOrWhiteSpace($Manifest) -or -not (Test-Path $Manifest)) {
    throw "Rollback manifest not found."
}

$started = Get-Date
$items = Get-Content -Raw -Path $Manifest | ConvertFrom-Json

foreach ($item in $items) {
    docker image inspect $item.knownGoodImage *> $null
    if ($LASTEXITCODE -ne 0) {
        throw "Known-good image not found: $($item.knownGoodImage)"
    }

    docker tag $item.knownGoodImage $item.currentImage
    if ($LASTEXITCODE -ne 0) {
        throw "Failed restoring $($item.currentImage) from $($item.knownGoodImage)"
    }
}

if (-not $Services -or $Services.Count -eq 0) {
    $all = docker compose -p $ComposeProject -f $ComposeFile config --services
    $Services = @(
        $all | Where-Object {
            $_ -match "(api|worker|web|website|frontend|app)" -and
            $_ -notmatch "(postgres|db|database|redis|mysql|oracle|mssql|caddy)"
        }
    )
}

docker compose -p $ComposeProject -f $ComposeFile up -d --no-deps @Services

if ($LASTEXITCODE -ne 0) {
    throw "Rollback compose up failed."
}

$elapsed = [int]((Get-Date) - $started).TotalSeconds

if ($elapsed -gt 120) {
    throw "Rollback exceeded 120 seconds. Elapsed=${elapsed}s"
}

Write-Host "[GREEN] P1-T01 rollback completed in ${elapsed}s."
'@

    Write-P1 "Building/recreating app services only, with --no-deps. Postgres service will not be recreated."

    $composeArgs = @(
        "-p", $ComposeProject,
        "-f", $ComposeFile,
        "-f", $envFile,
        "up", "-d", "--no-deps", "--build"
    ) + $AppServices

    & docker compose @composeArgs
    if ($LASTEXITCODE -ne 0) {
        throw "docker compose app-service redeploy failed."
    }

    Start-Sleep -Seconds 8

    $runningIdsAfter = Get-ContainerIdsForServices -ComposeFile $ComposeFile -Services $AppServices

    if ($runningIdsAfter.Count -eq 0) {
        throw "No app service containers are running after redeploy."
    }

    foreach ($id in $runningIdsAfter) {
        $name = (& docker inspect -f "{{.Name}}" $id).Trim().TrimStart("/")
        $state = (& docker inspect -f "{{.State.Status}}" $id).Trim()
        $restartCount = (& docker inspect -f "{{.RestartCount}}" $id).Trim()

        if ($state -ne "running") {
            throw "Container $name is not running. State=$state"
        }

        if ([int]$restartCount -ne 0) {
            throw "Container $name has RestartCount=$restartCount. Expected 0."
        }
    }

    $volumeAfter = Get-PostgresVolumeIdentity
    $rowsAfter = Get-PostgresRowCountsSnapshot

    Write-TextFile -Path (Join-Path $EvidenceRoot "postgres-volume-after.txt") -Content $volumeAfter
    Write-TextFile -Path (Join-Path $EvidenceRoot "postgres-rowcounts-after.txt") -Content $rowsAfter

    if ($volumeBefore -ne $volumeAfter) {
        throw "Postgres volume identity changed. Before=$volumeBefore After=$volumeAfter"
    }

    if ($rowsBefore -notmatch "UNAVAILABLE" -and $rowsAfter -notmatch "UNAVAILABLE" -and $rowsBefore -ne $rowsAfter) {
        throw "Postgres row-count snapshot changed during P1-T01 deploy. See evidence folder."
    }

    Write-P1 "Validating HTTP build/version endpoints."

    $version = Invoke-HttpOk -Url "$ApiBaseUrl/version" -Name "API /version"
    Write-TextFile -Path (Join-Path $EvidenceRoot "api-version.json") -Content $version

    if ($version -notmatch [regex]::Escape($Commit)) {
        throw "API /version does not show latest commit $Commit. Response: $version"
    }

    if (-not [string]::IsNullOrWhiteSpace($AppBaseUrl)) {
        $appHtml = Invoke-HttpOk -Url $AppBaseUrl -Name "frontend app"
        Write-TextFile -Path (Join-Path $EvidenceRoot "frontend-home.html") -Content $appHtml
    }

    if (-not [string]::IsNullOrWhiteSpace($WebsiteBaseUrl)) {
        $websiteHtml = Invoke-HttpOk -Url $WebsiteBaseUrl -Name "website"
        Write-TextFile -Path (Join-Path $EvidenceRoot "website-home.html") -Content $websiteHtml
    }

    Write-P1 "Running stability check for $StabilityMinutes minute(s)."

    for ($i = 1; $i -le $StabilityMinutes; $i++) {
        Invoke-HttpOk -Url "$ApiBaseUrl/version" -Name "API stability $i/$StabilityMinutes" | Out-Null

        foreach ($id in $runningIdsAfter) {
            $name = (& docker inspect -f "{{.Name}}" $id).Trim().TrimStart("/")
            $state = (& docker inspect -f "{{.State.Status}}" $id).Trim()
            $restartCount = (& docker inspect -f "{{.RestartCount}}" $id).Trim()

            if ($state -ne "running") {
                throw "During stability check, container $name is not running. State=$state"
            }

            if ([int]$restartCount -ne 0) {
                throw "During stability check, container $name has RestartCount=$restartCount. Expected 0."
            }
        }

        if ($i -lt $StabilityMinutes) {
            Start-Sleep -Seconds 60
        }
    }

    $finalContainers = & docker ps -a --format "{{.Names}}|{{.Status}}" |
        Where-Object { $_ -match "^(plantprocess|ppiq)" } |
        Sort-Object

    Write-TextFile -Path (Join-Path $EvidenceRoot "final-containers.txt") -Content (($finalContainers -join "`n") + "`n")

    $summary = @"
# P1-T01 Live-stack stabilization complete

Generated: $(Get-Date -Format o)

Commit: $Commit
Branch: $Branch
Compose project: $ComposeProject
Compose file: $ComposeFile
App services: $($AppServices -join ', ')

Validation:
- App services rebuilt/recreated with --no-deps.
- Postgres volume identity unchanged.
- Row-count snapshot unchanged when available.
- Crash-loop/exited plantprocess/ppiq orphan app containers removed.
- API /version serves latest commit.
- RestartCount stayed 0 for $StabilityMinutes minute(s).
- Rollback script created: deploy\live\rollback-p1-t01.ps1
- Rollback manifest created: $rollbackManifest

Evidence folder:
$EvidenceRoot
"@

    Write-TextFile -Path (Join-Path $EvidenceRoot "P1-T01_SUMMARY.md") -Content $summary

    Write-Green "P1-T01 is DONE by description and validation."
    Write-Host "Evidence: $EvidenceRoot"
    Write-Host "Rollback: .\deploy\live\rollback-p1-t01.ps1"
}
finally {
    Stop-Transcript | Out-Null
}
