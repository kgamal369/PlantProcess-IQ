PS>function Get-ContainerIdsForServices {
    param(
        [Parameter(Mandatory=$true)][string]$ComposeFile,
        [Parameter(Mandatory=$true)][string[]]$Services
    )

    $ids = @()

    foreach ($service in $Services) {
        $out = & docker compose -p $ComposeProject -f $ComposeFile ps -q $service 2>$null
        if ($LASTEXITCODE -eq 0 -and $out) {
            $ids += @($out | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
        }
    }

    return @($ids | Select-Object -Unique)
}
