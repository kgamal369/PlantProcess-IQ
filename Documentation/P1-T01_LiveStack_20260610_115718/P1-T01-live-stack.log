PS>function Get-PostgresVolumeIdentity {
    $volumes = @(
        "ppiq-postgres-data",
        "plantprocessiq_postgres-data",
        "plantprocessiq_postgres_data",
        "postgres-data",
        "postgres_data"
    )

    foreach ($volume in $volumes) {
        $id = (& docker volume inspect $volume --format "{{.Name}}|{{.Mountpoint}}" 2>$null)
        if ($LASTEXITCODE -eq 0 -and -not [string]::IsNullOrWhiteSpace($id)) {
            return $id.Trim()
        }
    }

    $detected = & docker volume ls --format "{{.Name}}" |
        Where-Object { $_ -match "(ppiq|plantprocess).*postgres|postgres.*(ppiq|plantprocess)" } |
        Select-Object -First 1

    if ($detected) {
        $id = (& docker volume inspect $detected --format "{{.Name}}|{{.Mountpoint}}" 2>$null)
        if ($LASTEXITCODE -eq 0 -and -not [string]::IsNullOrWhiteSpace($id)) {
            return $id.Trim()
        }
    }

    return "POSTGRES_VOLUME_NOT_FOUND"
}
